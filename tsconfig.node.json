{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": ["electron.vite.config.*", "src/main/**/*", "src/preload/**/*", "src/shared/**/*", "extensions/**/*"],
  "exclude": ["extensions/vscode/**/*"],
  "compilerOptions": {
    "composite": true,
    "experimentalDecorators": true,
    "types": ["electron-vite/node"],
    "paths": {
      "*": ["./*"],
      "@/*": ["./src/main/*"],
      "@main/*": ["./src/main/*"],
      "@shared/*": ["./src/shared/*"]
    }
  }
}
